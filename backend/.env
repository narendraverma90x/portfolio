# Server configuration
PORT=5000
NODE_ENV=development

# JWT Authentication secret
JWT_SECRET=supersecretportfoliojwtkey123!@#

# Database (Leave blank to automatically fallback to local JSON database)
MONGODB_URI=

# Admin Credentials (Set these to seed your initial admin user)
ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@portfolio.dev
ADMIN_PASSWORD=adminpassword123

# Cloudinary Storage Configuration (Optional, falls back to local uploads if blank)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Nodemailer Email Configuration (Optional, triggers mail transmission if set)
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
CONTACT_RECEIVER_EMAIL=
